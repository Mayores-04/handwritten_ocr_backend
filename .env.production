# ========================================
# PRODUCTION - Render.com Deployment
# ========================================

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=8000

# Model Configuration
MODEL_PATH=models/handwriting_model.keras

# Logging
LOG_LEVEL=INFO

# Security
SECRET_KEY=your_secret_key_here_change_in_render_dashboard

# Model Loading
# Set to true if you have GPU available (Render paid plans)
USE_GPU=false

# Timeout for OCR operations (in seconds)
OCR_TIMEOUT=60
